# DreamPort 独立后端 systemd 单元
# 安装: cp deploy/dreamport-server.service /etc/systemd/system/
#       mkdir -p /opt/dreamport && 放入 jar
#       systemctl daemon-reload && systemctl enable --now dreamport-server
[Unit]
Description=DreamPort - Minecraft Server Portal & Player Management
After=network.target mysql.service

[Service]
Type=simple
User=dreamport
WorkingDirectory=/opt/dreamport
ExecStart=/usr/bin/java -jar /opt/dreamport/dreamport-server-0.1.0.jar --spring.profiles.active=mysql
Environment=WL_JWT_SECRET=__CHANGE_ME__
Environment=WL_DB_HOST=127.0.0.1
Environment=WL_DB_NAME=dreamport
Environment=WL_DB_USER=dreamport
Environment=WL_DB_PASSWORD=__CHANGE_ME__
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
