# DreamPort 独立后端 systemd 单元
# 安装: mkdir -p /opt/dreamport && 放入 jar → 启动一次生成 config.yml → 编辑后重启
#       cp deploy/dreamport-server.service /etc/systemd/system/
#       systemctl daemon-reload && systemctl enable --now dreamport-server
[Unit]
Description=DreamPort - Minecraft Server Portal & Player Management
After=network.target mysql.service

[Service]
Type=simple
User=dreamport
WorkingDirectory=/opt/dreamport
# 所有配置在工作目录 config.yml 中编辑（首次启动自动生成）
ExecStart=/usr/bin/java -jar /opt/dreamport/dreamport-server-1.0.0.jar
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
